{
  "name": "mandujs",
  "version": "0.10.0",
  "private": true,
  "license": "MPL-2.0",
  "author": "Liam Ko",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.12"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "demo/*"
    ],
    "catalog": {
      "fast-glob": "^3.3.2"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:core": "bun run scripts/test-core.ts",
    "test:core:mysql-e2e": "bun run scripts/test-mysql-resource-e2e.ts",
    "test:cli": "bun test packages/cli/src packages/cli/tests packages/cli/templates/default/tests packages/cli/templates/realtime-chat/tests",
    "test:mcp": "bun test packages/mcp/tests",
    "test:ate": "bun test packages/ate/src packages/ate/tests packages/ate/__tests__",
    "test:edge": "bun test packages/edge/__tests__",
    "test:edge:build": "bun run scripts/edge-build-smoke.ts",
    "test:skills": "bun test packages/skills/src",
    "generate:official-skills": "bun run scripts/generate-official-skills.ts",
    "check:official-skills": "bun run scripts/check-official-skills.ts",
    "test:playground-runner": "bun test packages/playground-runner/tests",
    "test:product": "bun run test:core && bun run test:cli && bun run test:mcp",
    "test:generated": "bun run test:skills",
    "test:labs": "bun run test:ate && bun run test:edge && bun run test:edge:build && bun run test:playground-runner",
    "test:demo": "bun run test:smoke",
    "test:smoke": "bun run ./scripts/smoke.ts",
    "test:reference-apps": "bun run ./scripts/reference-app-gate.ts",
    "test:agent-apply-gate": "bun run scripts/agent-apply-benchmark.ts",
    "test:hydration-boundary": "bun test packages/core/src/router/fs-routes.test.ts packages/core/src/router/client-entry.test.ts packages/core/src/bundler/__tests__/client-boundary-transform.test.ts packages/core/src/bundler/build.test.ts packages/core/src/runtime/__tests__/page-render-response.test.ts packages/core/src/runtime/__tests__/inline-client-hydration.test.ts",
    "test:hydration-e2e": "bun run scripts/test-hydration-e2e.ts",
    "check:hydration": "bun run test:hydration-boundary && bun run test:hydration-e2e",
    "test:packages": "bun run test:product && bun run test:generated && bun run test:labs",
    "perf:baseline:check": "bun run scripts/perf-baseline.ts",
    "perf:budget:check": "bun run scripts/perf-budget.ts",
    "perf:run": "bun run scripts/perf-run.ts",
    "perf:ci": "bun run perf:run -- --runs 1 --warmup 0 && bun run perf:budget:check -- --summary .perf/latest/summary.json --markdown-out .perf/latest/budget-check.md --enforce",
    "perf:expanded": "bun run perf:run -- --scenario auth-starter-hmr-island --scenario auth-starter-cold-start --runs 1 --warmup 0 && bun run perf:budget:check -- --summary .perf/latest/summary.json --markdown-out .perf/latest/budget-check.md --enforce && bun run perf:streaming",
    "perf:streaming": "bun run scripts/streaming-ssr-bench.ts --runs 3 --warmup 1 --budget 1500 --json-out .perf/latest/streaming-ssr.json",
    "perf:hydration": "bun run packages/core/benchmark/hydration-benchmark.ts",
    "mandu": "bun run packages/cli/src/main.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install",
    "version:product": "bun run scripts/version-product.ts",
    "publish": "bun run scripts/publish.ts",
    "publish:product": "bun run scripts/publish.ts --product",
    "publish:dry": "bun run scripts/publish.ts --dry-run",
    "publish:force": "bun run scripts/publish.ts --skip-check",
    "release": "bun run version && bun run publish",
    "typecheck": "bun run scripts/typecheck.ts",
    "typecheck:product": "bun run scripts/typecheck.ts core cli mcp",
    "typecheck:labs": "bun run scripts/typecheck.ts ate edge playground-runner",
    "lint": "oxlint packages/",
    "lint:product": "oxlint packages/core packages/cli packages/mcp",
    "lint:labs": "oxlint packages/ate packages/edge packages/playground-runner",
    "lint:type-aware": "bun run scripts/lint-type-aware.ts",
    "lint:type-aware:debt": "oxlint --type-aware packages/core/src packages/cli/src packages/mcp/src packages/ate/src packages/edge/src packages/skills/src packages/playground-runner/src --ignore-pattern \"**/__tests__/**\" --ignore-pattern \"**/*.test.ts\" --ignore-pattern \"**/*.test.tsx\"",
    "lint:type-aware:full": "oxlint --type-aware packages/",
    "lint:fix": "oxlint --fix packages/",
    "check:npm-drift": "bun run scripts/check-npm-drift.ts",
    "check:public-api": "bun run scripts/check-public-api-boundary.ts",
    "check:core-v1-imports": "bun run packages/cli/src/codemod.ts core-v1 packages demo scripts tests --check",
    "migrate:core-v1": "bun run packages/cli/src/codemod.ts core-v1 packages demo scripts tests --write",
    "check:package-boundaries": "bun run scripts/check-package-boundaries.ts",
    "check:target-boundaries": "bun run scripts/check-target-boundaries.ts",
    "check:docs-drift": "bun run scripts/check-docs-drift.ts",
    "check:publish": "bun run scripts/pre-publish-check.ts",
    "check:product-release": "bun run scripts/pre-publish-check.ts --product",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript/native-preview": "^7.0.0-dev.20260421.2",
    "bun-types": "^1.3.14",
    "lefthook": "^1.11.0",
    "oxlint": "^1.61.0",
    "oxlint-tsgolint": "^0.21.1",
    "playwright": "^1.49.0",
    "typescript": ">=6.0.0"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-refresh": "^0.18.0",
    "zod": "^3.22.0"
  }
}
